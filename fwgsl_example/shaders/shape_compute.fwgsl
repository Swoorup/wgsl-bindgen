-- Shape compute shader — data-carrying algebraic data type in fwgsl
-- Written in fwgsl (https://github.com/ubugeeei/fwgsl)
--
-- This shader demonstrates *data-carrying* algebraic data types (ADTs) in fwgsl.
--
-- `data Shape = Circle F32 | Rect F32 F32` defines:
--   Circle — a circle described by one F32 field (radius)
--   Rect   — a rectangle described by two F32 fields (width, height)
--
-- The fwgsl compiler lowers each constructor to a WGSL struct:
--
--   struct Circle { field0: f32 }            -- radius
--   struct Rect   { field0: f32, field1: f32 } -- width, height
--
-- The build.rs for this crate extracts the ADT metadata from the fwgsl HIR and
-- injects a `// @fwgsl-adt:` annotation into the combined WGSL source.
-- wgsl-bindgen automatically parses this annotation and generates:
--
--   pub enum Shape {
--       Circle(Circle),  -- Shape::Circle carries a Circle struct
--       Rect(Rect),      -- Shape::Rect carries a Rect struct
--   }
--
-- with a `.tag() -> u32` method that returns the WGSL discriminant.
-- No WgslEnumDefinition is needed — extraction is fully automatic.
--
-- The `-- @wgsl` section below is the GPU setup ceremony for this shader.

data Shape = Circle F32 | Rect F32 F32

-- @wgsl
struct ShapeParams {
    tag: u32,
    field0: f32,
    field1: f32,
    _pad: f32,
}

@group(0) @binding(0) var<storage, read_write> output: array<f32, 1>;
@group(0) @binding(1) var<uniform> params: ShapeParams;

@compute @workgroup_size(1, 1, 1)
fn main(@builtin(global_invocation_id) _global_id: vec3<u32>) {
    var area: f32 = 0.0;
    if params.tag == 0u {
        area = params.field0 * params.field0;
    } else {
        area = params.field0 * params.field1;
    }
    output[0] = area;
}
