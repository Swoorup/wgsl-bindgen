    ) {
      self.set_bind_group(index, bind_group, offsets);
    }
  }
}
#[allow(unused, non_snake_case, non_camel_case_types, non_upper_case_globals)]
pub mod layout_asserts {
  use super::{_root, _root::*};
  const WGSL_BASE_TYPE_ASSERTS: () = {};
  const ISSUE_109_FIXED_LAYOUT_ASSERTS: () = {
    assert!(std::mem::offset_of!(issue_109::FixedLayout, direction) == 0);
    assert!(std::mem::offset_of!(issue_109::FixedLayout, samples) == 16);
    assert!(std::mem::offset_of!(issue_109::FixedLayout, marker) == 48);
    assert!(std::mem::align_of::<issue_109::FixedLayout>() == 16);
    assert!(std::mem::size_of::<issue_109::FixedLayout>() == 64);
  };
  const ISSUE_109_RUNTIME_LAYOUT_ASSERTS: () = {
    assert!(std::mem::offset_of!(issue_109::RuntimeLayoutSized<0>, header) == 0);
    assert!(std::mem::offset_of!(issue_109::RuntimeLayoutSized<0>, values) == 64);
    assert!(std::mem::align_of::<issue_109::RuntimeLayoutSized<0>>() == 16);
    assert!(std::mem::size_of::<u32>() == 4);
  };
}
